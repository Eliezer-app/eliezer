{
  "name": "eliezer",
  "type": "module",
  "scripts": {
    "dev": "tsx eliezer.mts",
    "check": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:up": "docker compose -f docker-compose.test.yml up -d --build",
    "test:down": "docker compose -f docker-compose.test.yml down"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.11.0",
    "dotenv": "^16.4.7",
    "exifr": "^7.1.3",
    "puppeteer": "^24.37.3",
    "tiktoken": "^1.0.22"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
