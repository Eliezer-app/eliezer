# Eliezer configuration
# Copy this to .env and fill in your values

LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-5-20250514
AGENT_PORT=3200
DB_PATH=./state/eliezer.db
CHAT_URL=http://localhost:3100
PROMPTS_DIR=./prompts
SEARCH_URL=http://localhost:8080
CONTEXT_WINDOW=200000
HEARTBEAT_MS=30_000
USER_TZ=UTC

# Optional: separate LLM for compaction (defaults to main LLM)
# COMPACTION_LLM_PROVIDER=
# COMPACTION_LLM_API_KEY=
# COMPACTION_LLM_MODEL=
# COMPACTION_LLM_BASE_URL=
