[Unit]
Description=Eliezer AI Agent
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/eliezer
ExecStart=/usr/bin/npx tsx eliezer.mts
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Env
EnvironmentFile=/opt/eliezer/.env

# Logging — stdout/stderr go to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=eliezer

# Hardening
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
